using System;

class Program
{
    static void Main()
    {
        Console.Write("Indicar precio de lista: ");
        decimal precio = decimal.Parse(Console.ReadLine());
        
        decimal precioD = precio * 0.18;
        
        Console.WriteLine($"Precio de lista: ${precio:0.00}");
        Console.WriteLine("Descuento: 18% sobre el precio de lista.");
        Console.WriteLine($"Precio con descuento: ${precioD:0.00}");
    }
}
