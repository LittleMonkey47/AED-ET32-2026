using System;

class Program
{
    static void Main()
    {
        int[] valores = new int[8];

        for (int i = 0; i < valores.Length; i++)
        {
            Console.Write($"Ingresa el entero {i + 1}: ");
            valores[i] = int.Parse(Console.ReadLine());
        }

        int numeroMayor = valores[0];
        int indiceMayor = 0;

        for (int i = 1; i < valores.Length; i++)
        {
            if (valores[i] > numeroMayor)
            {
                numeroMayor = valores[i];
                indiceMayor = i;
            }
        }

        Console.WriteLine($"\nEl número más grande es: {numeroMayor}");
        Console.WriteLine($"Se encuentra en la posición (índice): {indiceMayor}");
    }
}
