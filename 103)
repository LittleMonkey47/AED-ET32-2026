using System;

class Program
{
    static void Main()
    {
        string[] ciudades = { "Madrid", "Buenos Aires", "Bogotá", "Lima", "Santiago" };
        
        Console.Write("Introduce el nombre de una ciudad para buscar: ");
        string buscar = Console.ReadLine();
        
        int posicionEncontrada = -1;

        for (int i = 0; i < ciudades.Length; i++)
        {
            if (ciudades[i].Equals(buscar, StringComparison.OrdinalIgnoreCase))
            {
                posicionEncontrada = i;
                break;
            }
        }

        if (posicionEncontrada != -1)
        {
            Console.WriteLine($"Ciudad encontrada en la posición (índice): {posicionEncontrada}");
        }
        else
        {
            Console.WriteLine("Ciudad no encontrada");
        }
    }
}
